{
	"name": "@bhsd/lezer-json",
	"version": "2.3.0",
	"description": "Lezer-based JSON/JSONC grammar",
	"keywords": [
		"codemirror",
		"lezer",
		"json",
		"jsonc"
	],
	"homepage": "https://github.com/bhsd-harry/lezer-json#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/lezer-json/issues"
	},
	"license": "MIT",
	"contributors": [
		"Arun Srinivasan <rulfzid@gmail.com>",
		"Marijn Haverbeke <marijn@haverbeke.berlin>",
		"Bhsd"
	],
	"files": [
		"dist/"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/lezer-json.git"
	},
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only -a --omit=dev",
		"prepublishOnly": "npm run build",
		"build:parser": "lezer-generator src/json.grammar -o src/parser.js",
		"build:core": "tsc && cp src/parser.js dist/ && eslint --no-config-lookup -c eslint.dist.js dist/*.js",
		"build": "npm run build:parser && npm run build:core",
		"lint:ts": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit && oxlint && eslint --cache .",
		"lint:md": "myMarkdownlint",
		"lint": "npm run lint:ts && npm run lint:md",
		"migrate": "oxlint-migrate",
		"test": "rm -rf test/dist/; tsc -p test/tsconfig.json && testUtil test/dist/*.test.js"
	},
	"peerDependencies": {
		"@codemirror/language": "^6.0.0",
		"@codemirror/lint": "^6.0.0"
	},
	"peerDependenciesMeta": {
		"@codemirror/lint": {
			"optional": true
		}
	},
	"dependencies": {
		"@bhsd/common": "^4.1.0"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^5.1.0",
		"@bhsd/test-util": "^3.3.0",
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.6",
		"@lezer/generator": "^1.8.1",
		"@oxlint/migrate": "^1.90.0",
		"eslint": "^10.14.0",
		"oxlint": "^1.90.0",
		"typescript": "^6.0.3"
	}
}
